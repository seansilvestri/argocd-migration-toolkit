# ArgoCD Migration Environment Profile
# Copy this file to envs/ and customize for your migration

# Source Control Plane (where App-of-Apps currently lives)
SOURCE_CLUSTER=source-cluster-name
SOURCE_KUBECONTEXT=source-k8s-context
SOURCE_ARGO_URL=argocd.source.example.com
SOURCE_ARGO_LOGIN_ARGS="--sso"  # or "--username admin --password <password>"

# Target Control Plane (where App-of-Apps will move to)
TARGET_CLUSTER=target-cluster-name
TARGET_KUBECONTEXT=target-k8s-context
TARGET_ARGO_URL=argocd.target.example.com
TARGET_ARGO_LOGIN_ARGS="--sso"

# App-of-Apps to migrate (space-separated list)
# These are the parent Applications that manage other Applications
SAFE_DELETE_PARENT_APPS="target-cluster-name.apps target-cluster-name.infra-apps"

# Target sync apps (usually same as SAFE_DELETE_PARENT_APPS)
TARGET_ARGO_SYNC_APPS="target-cluster-name.apps target-cluster-name.infra-apps"

# Optional: Include untracked applications in cleanup
# Set to true if you want to clean up Applications that lack tracking IDs
SAFE_DELETE_INCLUDE_UNTRACKED=false

# Optional: Custom manifest root (if running from different repo)
# MIG_MANIFEST_ROOT=/path/to/k8s-deployments-repo

# Optional: Custom app files (if not using default naming)
# RUNBOOK_APP_FILES="apps-target-cluster-name.yaml infra-apps-target-cluster-name.yaml"

# Optional: Disable auto context switching
# MIG_DISABLE_AUTO_CONTEXT=false
# MIG_DISABLE_AUTO_ARGO_LOGIN=false

# Standard Migration Test Configuration
# Tests parent-based discovery with cluster-prefix naming convention
# Usage: source tests/test-configs/standard.env

SOURCE_CLUSTER=source-argocd
SOURCE_KUBECONTEXT=kind-source-argocd
SOURCE_ARGO_URL=localhost:8080
SOURCE_ARGO_LOGIN_ARGS="--username admin --password admin --insecure"

TARGET_CLUSTER=target-argocd
TARGET_KUBECONTEXT=kind-target-argocd
TARGET_ARGO_URL=localhost:8081
TARGET_ARGO_LOGIN_ARGS="--username admin --password admin --insecure"
TARGET_ARGO_APP=workload-cluster.apps

# Parent app configuration
SAFE_DELETE_PARENT_APPS="workload-cluster.apps"
TARGET_ARGO_APP="workload-cluster.apps"
TARGET_ARGO_SYNC_APPS="workload-cluster.apps"

# Manifest root (working directory - will be populated from fixtures)
MIG_MANIFEST_ROOT="$(pwd)/test-results/standard"

# Path-Based Discovery Test Configuration
# Tests path-based discovery without parent apps or cluster-prefix naming
# Usage: source tests/test-configs/path-based.env

SOURCE_CLUSTER=source-argocd
SOURCE_KUBECONTEXT=kind-source-argocd
SOURCE_ARGO_URL=localhost:8080
SOURCE_ARGO_LOGIN_ARGS="--username admin --password admin --insecure"

TARGET_CLUSTER=target-argocd
TARGET_KUBECONTEXT=kind-target-argocd
TARGET_ARGO_URL=localhost:8081
TARGET_ARGO_LOGIN_ARGS="--username admin --password admin --insecure"

# Enable path-based discovery mode
MIG_PATH_BASED_DISCOVERY=true

# NO parent app - using --path-based-discovery instead
# SAFE_DELETE_PARENT_APPS will be empty (migration-env.sh handles this automatically)
# TARGET_ARGO_APP is set to the individual app name (not a parent app)
TARGET_ARGO_APP=my-app

# Manifest root (working directory - will be populated from fixtures)
MIG_MANIFEST_ROOT="$(pwd)/test-results/path-based"
